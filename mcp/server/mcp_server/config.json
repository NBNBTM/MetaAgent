{
  "global": {
    "server_name": "MetaAgent Public Tools",
    "debug": false,
    "log_level": "INFO",
    "transport": "stdio",
    "dependencies": [
      "numpy",
      "pandas",
      "scikit-learn",
      "matplotlib",
      "seaborn",
      "scipy",
      "sympy"
    ]
  },
  "modules": {
    "calculator": {
      "enabled": true
    },
    "data_analysis": {
      "enabled": true,
      "default_clustering_method": "kmeans",
      "default_dimension_reduction_method": "pca",
      "default_classification_method": "random_forest"
    }
  }
}
