# Copy this file to .env and fill in your own values.
# Never commit .env.

OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=gpt-4o-mini

MAX_TOKENS=4096
TEMPERATURE=0.4
TIMEOUT=120
MAX_MESSAGES=30
DEBUG=false
SECRET_KEY=metaagent-local-dev

METAAGENT_DATA_DIR=data
DATABASE_PATH=metaagent.sqlite3
UPLOAD_DIR=uploads

SYSTEM_PROMPT=prompt/system.md
META_AGENT_PROMPT=prompt/meta_agent.md
MCP_SERVER_CONFIG_PATH=mcp_server_config.json

# Usually the defaults are enough. Leave blank to use the interpreter running app.py.
METAAGENT_PYTHON_PATH=
METAAGENT_NODE_PATH=node
METAAGENT_NPX_PATH=npx

# Optional external MCP services can read keys from environment variables.
# Tavily is disabled in mcp_server_config.json by default; enable it only after setting this key.
TAVILY_API_KEY=
